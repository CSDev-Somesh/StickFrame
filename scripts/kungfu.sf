# StickFrame — Kung Fu Demo v6 (Full Camera: smooth follow, zoom, shake)
scene dojo width=800 height=400 fps=24

camera main:
    follow fighter
    zoom 1.0

character fighter:
    rig bipedal
    appearance head_color="#FFD700" body_color="#222222"
    scale=2.8
    position (400, 274)

timeline:
    scene dojo:
        0.0s     fighter.idle
        0.5s     camera.zoom_to(zoom=1.3)
        0.6s     fighter.punch
        0.7s     camera.shake(intensity=6, duration=0.15)
        1.0s     camera.zoom_to(zoom=1.0)
        1.2s     fighter.punch
        1.3s     camera.shake(intensity=8, duration=0.2)
        1.8s     camera.zoom_to(zoom=1.2)
        1.8s     fighter.jump
        2.5s     camera.zoom_to(zoom=1.0)
        2.5s     fighter.idle
        3.0s     camera.zoom_to(zoom=1.4)
        3.0s     fighter.punch
        3.1s     camera.shake(intensity=10, duration=0.25)
        3.5s     camera.zoom_to(zoom=1.0)
        3.6s     fighter.jump
        4.4s     camera.zoom_to(zoom=1.2)
        4.4s     fighter.punch
        4.5s     camera.shake(intensity=7, duration=0.15)
        5.0s     camera.zoom_to(zoom=1.0)
        5.0s     fighter.idle
        5.6s     fighter.jump
        6.3s     fighter.fall
        6.5s     camera.shake(intensity=12, duration=0.3)
        7.0s     camera.zoom_to(zoom=1.0)
        7.3s     fighter.idle