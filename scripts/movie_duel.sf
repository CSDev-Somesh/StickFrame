# StickFrame Movie Demo — "Duel at Dawn"
# Custom action defined IN the script (no Python needed)
action uppercut:
    duration 0.5
    0.0  spine=-85 left_upper_arm=180 right_upper_arm=190
    0.2  spine=-80 right_upper_arm=120 right_forearm=10
    0.5  spine=-85 right_upper_arm=190

scene dojo width=800 height=600 fps=24

camera wide:
    zoom 1.0

camera closeup:
    zoom 1.5
    follow hero

character hero:
    rig bipedal
    appearance head_color="#FFD700" shirt_color="#2E86DE" pants_color="#1B2A4A" shoe_color="#8B4513" skin_color="#FFDAB9"
    scale=2.5
    position (300, 374)

character villain:
    rig bipedal
    appearance head_color="#8B0000" shirt_color="#4A0000" pants_color="#2B0A0A" shoe_color="#222222" skin_color="#D2A679"
    scale=2.5
    position (500, 374)

timeline:
    scene act1:
        0.0s     bg.set(color="#F5E6C8")
        0.0s     hero.idle
        0.0s     villain.idle
        3.5s     hero.uppercut
        3.5s     camera.shake(intensity=8, duration=0.3)
        4.5s     villain.fall
    scene act2:
        5.5s     closeup.activate
        7.0s     bg.set(color="#1B2A4A")
        7.0s     wide.activate
        7.5s     hero.jump
        8.5s     hero.idle
