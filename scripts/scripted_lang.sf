# Creative .sf — programming language style
scene scripted width=800 height=600 fps=30

camera main:
    follow hero
    zoom 1.0

character hero:
    rig bipedal
    scale=2.5
    position (400, 374)

script:
    var t = 0.5
    repeat 3:
        hero.wave at t
        t = t + 0.8

    hero.punch(power=95) at t

    if t > 2:
        hero.kick at t + 0.5
    else:
        hero.point at t

    var f = 0.0
    def combo(n):
        repeat n:
            hero.punch at f
            f += 0.6
    combo(2)

    for i in range(2):
        hero.happy at 5.0 + i
