# StickFrame Script — procedural test
scene demo width=640 height=360 fps=15

character hero:
    rig bipedal
    appearance head_color="#FFD700" body_color="#222"
    position (80, 250)

timeline:
    scene demo:
        0.0s     hero.idle
        1.0s     hero.walk
        4.0s     hero.jump
        5.0s     hero.idle